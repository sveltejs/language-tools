{
    "name": "@sveltejs/ts-content-mapper",
    "version": "0.1.1",
    "description": "Content mapper turning Svelte files into something TypeScript 7+ understands",
    "homepage": "https://github.com/sveltejs/language-tools/tree/master/packages/typescript-content-mapper",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sveltejs/language-tools.git"
    },
    "scripts": {
        "build": "tsc"
    },
    "keywords": [],
    "author": "",
    "license": "MIT",
    "type": "module",
    "files": [
        "dist"
    ],
    "typescript": {
        "contentMapper": {
            "exec": [
                "node",
                "dist/server.js"
            ],
            "compilerOptions": []
        }
    },
    "dependencies": {
        "@sveltejs/load-config": "workspace:^",
        "svelte2tsx": "workspace:~",
        "typescript": "~6.0.2",
        "vscode-jsonrpc": "^8.2.0"
    },
    "devDependencies": {
        "@types/node": "^18.0.0"
    }
}
