{
    "compilerOptions": {
        "strict": true,
        "checkJs": true,
        /**
          This is actually not needed, but makes the tests faster
          because TS does not look up other types.
        */
        "types": ["svelte"]
    },
    "contentMappers": [
        {
            "package": "@sveltejs/ts-content-mapper",
            "extensions": [".svelte"]
        }
    ]
}
