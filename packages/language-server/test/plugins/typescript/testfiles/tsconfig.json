{
    "compilerOptions": {
        "allowJs": true,
        "target": "ESNext",
        "strict": true,
        /**
          This is actually not needed, but makes the tests faster
          because TS does not look up other types.
        */
        "types": ["svelte"],
        /**For testing import json file*/
        "resolveJsonModule": true
    },
    "include": ["**/*", "./.svelte-kit/**/*"],
    "exclude": [
        /**For testing exclude */
        "./dist"
    ]
}
