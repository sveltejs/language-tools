// Modelled on the tsconfig.app.json of Vite's svelte-ts template, with the options of
// @tsconfig/svelte inlined (it isn't installed in the test workspace)
{
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
        "target": "es2023",
        "module": "esnext",
        "moduleResolution": "bundler",
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "strict": true,
        "skipLibCheck": true,
        "allowArbitraryExtensions": true,
        "noEmit": true,
        "allowJs": true,
        "checkJs": true,
        "moduleDetection": "force"
    },
    "include": ["src/**/*.ts", "src/**/*.js", "src/**/*.svelte"],
    "contentMappers": [{ "package": "@sveltejs/ts-content-mapper", "extensions": [".svelte"] }]
}
